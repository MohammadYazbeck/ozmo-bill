POSTGRES_USER="ozmo_admin"
POSTGRES_PASSWORD="ozmo_dev_password"
POSTGRES_DB="ozmo_bill"
APP_DB_USER="ozmo_app"
APP_DB_PASSWORD="ozmo_app_dev_password"

# Prisma migrations and the seed use the owner connection. Next.js uses only
# the restricted application connection at runtime.
MIGRATION_DATABASE_URL="postgresql://ozmo_admin:ozmo_dev_password@127.0.0.1:55433/ozmo_bill?schema=public"
DATABASE_URL="postgresql://ozmo_app:ozmo_app_dev_password@127.0.0.1:55433/ozmo_bill?schema=public"
APP_TIME_ZONE="Asia/Damascus"
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
NEXT_TELEMETRY_DISABLED=1
